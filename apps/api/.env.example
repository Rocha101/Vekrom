# Copie para .env
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://vekrom:vekrom@localhost:5432/vekrom
# PgBouncer-ready: aponte para o pooler em produção, ex:
# DATABASE_URL=postgres://vekrom:vekrom@pgbouncer:6432/vekrom?sslmode=require
PGPOOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-este-secret-por-um-valor-longo-e-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3001
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Quando S3_* estiverem preenchidos, troque upload.ts para fazer upload ao S3
# em vez de salvar em disco (o retorno URL já é compatível).
